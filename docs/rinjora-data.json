    "tujajure": [
        {
            "t": "Agaca gacakiye agahori gati:",
            "p": "Mwana wa mama undiye twari bamwe."
        },
        {
            "t": "Agaca gacakiye agahori gati:",
            "p": "Nagira ngo akaguruka ntikoriye akandi."
        },
        {
            "t": "Agaca gacakiye agahori gati, kano kati:",
            "p": "Urandya neza ndahanda."
        },
        {
            "t": "Agahume gahwaniye n'akandi mu mwonga ngo:",
            "p": "Rinda tubane waragowe ndagorwa."
        },
        {
            "t": "Agakara kagiye iwa sebukwe ngo agataramure kano gahitanywe gaca mu mbavu ati:",
            "p": "Ni wewe ga mupfaso? Na ko ngo ego agakara gasa n'akandi."
        },
        {
            "t": "Agakecuru kasanze akandi mu kuzimu kati:",
            "p": "Nyereka ibigega wimbuye. Na ko kati: Noneho ngaho mama uraje kuvyiyimburira nawe."
        },
        {
            "t": "Agakecuru kashikuye igikoba kigata ku kingi kati:",
            "p": "Nakudya ntitwarwana."
        },
        {
            "t": "Agakecuru karose gapfa gati:",
            "p": "Maze simvyanka."
        },
        {
            "t": "Akagomba kaneye mu cibo kati:",
            "p": "Urantuma mugabo wa mama ishikanwa ry'umworo ni iryo."
        },
        {
